---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { CONTACT } from '../config';
import { graph, businessSchema, breadcrumbSchema } from '../lib/schema';
import { getGalleryPhotos } from '../lib/gallery';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const categories = services
  .map((s) => ({
    slug: s.id,
    navLabel: s.data.navLabel,
    photos: getGalleryPhotos(s.id),
  }))
  .filter((c) => c.photos.length > 0);

const jsonLd = graph(
  businessSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Gallery', path: '/gallery/' },
  ]),
);
---

<BaseLayout
  title="Photo gallery | English Handyman Berlin"
  description="Real photos from renovation and handyman jobs across Berlin — kitchens, bathrooms, flooring, painting, tiling and more."
  canonical="/gallery/"
  jsonLd={jsonLd}
>
  <Breadcrumbs trail={[{ name: 'Gallery', path: '/gallery/' }]} />

  <div class="container-page pt-8">
    <header class="max-w-3xl">
      <h1 class="font-display text-3xl font-extrabold leading-tight text-ink-950 sm:text-4xl lg:text-5xl">
        Photo gallery
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">
        Real jobs, real Berlin flats — no stock photos. A mix of finished work and the process
        behind it: strip-outs, first fix, tiling and the rest.
      </p>
      {
        CONTACT.instagramUrl && (
          <a
            href={CONTACT.instagramUrl}
            target="_blank"
            rel="noopener"
            class="plausible-event-name=Instagram+Click mt-4 inline-flex items-center gap-2 font-semibold text-ink-700 hover:text-accent-700"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="shrink-0">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            New jobs go up first on Instagram — @{CONTACT.instagram}
          </a>
        )
      }
    </header>

    {
      categories.map((cat) => (
        <section class="mt-16" id={cat.slug}>
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-display text-2xl font-extrabold text-ink-950 lg:text-3xl">
              {cat.navLabel}
            </h2>
            <a
              href={`/services/${cat.slug}/`}
              class="whitespace-nowrap text-sm font-semibold text-accent-700 hover:underline"
            >
              About this service &rarr;
            </a>
          </div>
          <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            {cat.photos.map((photo) => (
              <li>
                <button
                  type="button"
                  class="lightbox-trigger group block w-full overflow-hidden rounded-lg bg-ink-100"
                  data-full-jpg={`${photo.base}.jpg`}
                  data-full-webp={`${photo.base}.webp`}
                  data-alt={photo.alt}
                  aria-label={`Open larger photo: ${photo.alt}`}
                >
                  <picture>
                    <source srcset={`${photo.base}-thumb.webp`} type="image/webp" />
                    <img
                      src={`${photo.base}-thumb.jpg`}
                      alt={photo.alt}
                      loading="lazy"
                      width="640"
                      height="640"
                      class="aspect-square w-full object-cover transition-transform duration-200 group-hover:scale-105"
                    />
                  </picture>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <dialog id="lightbox" class="max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/90">
    <form method="dialog" class="fixed inset-0 flex items-center justify-center p-4 sm:p-8">
      <button
        type="submit"
        aria-label="Close"
        class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/60 text-2xl text-white hover:bg-black/80"
      >
        &times;
      </button>
      <picture>
        <source id="lightbox-webp" srcset="" type="image/webp" />
        <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-full rounded-lg object-contain" />
      </picture>
    </form>
  </dialog>

  <CtaBand />
</BaseLayout>

<script is:inline>
  (() => {
    const dialog = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    const webp = document.getElementById('lightbox-webp');
    if (!(dialog instanceof HTMLDialogElement) || !(img instanceof HTMLImageElement) || !webp) return;

    document.querySelectorAll('.lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const jpg = btn.getAttribute('data-full-jpg') ?? '';
        const wp = btn.getAttribute('data-full-webp') ?? '';
        const alt = btn.getAttribute('data-alt') ?? '';
        img.src = jpg;
        img.alt = alt;
        webp.setAttribute('srcset', wp);
        dialog.showModal();
      });
    });

    const form = dialog.querySelector('form');
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === form) dialog.close();
    });
  })();
</script>
