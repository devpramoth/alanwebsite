---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Button from '../../components/Button.astro';
import { CONTACT } from '../../config';
import { waLink } from '../../lib/whatsapp';
import { graph, businessSchema, faqSchema, breadcrumbSchema } from '../../lib/schema';

export const getStaticPaths: GetStaticPaths = async () => {
  const areas = await getCollection('areas', ({ data }) => !data.draft);
  return areas.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = (await getCollection('projects', ({ data }) => !data.draft)).filter(
  (p) => p.data.district === entry.id,
);

const path = `/areas/${entry.id}/`;
const waMessage = `Hi, I’d like a quote for some work in ${entry.data.name}.`;

const jsonLd = graph(
  businessSchema(),
  faqSchema(entry.data.faqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Areas', path: '/areas/' },
    { name: entry.data.name, path },
  ]),
);
---

<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.metaDescription}
  canonical={path}
  waMessage={waMessage}
  jsonLd={jsonLd}
>
  <Breadcrumbs trail={[{ name: 'Areas', path: '/areas/' }, { name: entry.data.name, path }]} />

  <article class="container-page pt-8">
    <header class="max-w-3xl">
      <h1 class="font-display text-3xl font-extrabold leading-tight text-ink-950 sm:text-4xl lg:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">{entry.data.summary}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button href={waLink(waMessage)} variant="whatsapp" external event="WhatsApp Click">
          WhatsApp about {entry.data.name}
        </Button>
        <a
          href={`tel:${CONTACT.phoneE164}`}
          class="plausible-event-name=Call+Click inline-flex items-center justify-center rounded-md border-2 border-ink-300 px-5 py-2.5 text-[0.95rem] font-semibold text-ink-900 transition-colors hover:border-ink-900"
        >
          {CONTACT.phoneDisplay}
        </a>
      </div>
    </header>

    <div class="prose-trade mt-12 max-w-3xl">
      <Content />
    </div>

    {
      projects.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-2xl font-extrabold text-ink-950 lg:text-3xl">
            Work in {entry.data.name}
          </h2>
          <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {projects.slice(0, 6).map((p) => (
              <li>
                <a href={`/projects/${p.id}/`} class="group block">
                  <h3 class="font-display text-lg font-bold text-ink-950 group-hover:text-accent-700">
                    {p.data.title}
                  </h3>
                  <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">{p.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-16">
      <h2 class="font-display text-2xl font-extrabold text-ink-950 lg:text-3xl">
        What I do in {entry.data.name}
      </h2>
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          services.map((s) => (
            <li>
              <a
                href={`/services/${s.id}/`}
                class="inline-flex rounded-full border-2 border-ink-200 px-5 py-2.5 text-[0.95rem] font-semibold text-ink-800 transition-colors hover:border-ink-950 hover:bg-ink-50"
              >
                {s.data.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="max-w-3xl">
      <FaqList faqs={entry.data.faqs} />
    </div>
  </article>

  <CtaBand
    heading={`Working in ${entry.data.name}?`}
    body="Send a photo of the room and a sentence about what you want. That's usually enough for me to come back with something useful."
    waMessage={waMessage}
  />
</BaseLayout>
