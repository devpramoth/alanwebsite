---
import Button from './Button.astro';
import { waLink, WA_DEFAULT } from '../lib/whatsapp';

interface Props {
  heading?: string;
  body?: string;
  waMessage?: string;
}

const {
  heading = 'Send me a photo and tell me what needs doing',
  body = "A picture and a sentence is usually enough for me to say whether it's a morning or a fortnight.",
  waMessage = WA_DEFAULT,
} = Astro.props;
---

<section class="mt-20 bg-accent-600">
  <div
    class="container-page flex flex-col items-start gap-8 py-14 lg:flex-row lg:items-center lg:justify-between"
  >
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-extrabold text-white lg:text-4xl">{heading}</h2>
      <p class="mt-3 text-lg leading-relaxed text-accent-50">{body}</p>
    </div>
    <div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row">
      <Button href={waLink(waMessage)} variant="whatsapp" size="lg" external event="WhatsApp Click">
        WhatsApp me
      </Button>
      <a
        href="/contact/"
        class="plausible-event-name=Quote+Click inline-flex items-center justify-center rounded-md bg-white px-6 py-3.5 font-semibold text-ink-950 transition-colors hover:bg-accent-50"
      >
        Get a quote
      </a>
    </div>
  </div>
</section>
