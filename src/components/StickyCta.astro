---
import { CONTACT } from '../config';
import { waLink } from '../lib/whatsapp';

interface Props {
  /** Page-specific pre-filled WhatsApp message. */
  waMessage: string;
}

const { waMessage } = Astro.props;
---

{/*
  Mobile lead bar. Most visitors are standing in a half-finished flat holding a
  phone, so the three actions that matter are always one thumb-reach away.
  Hidden at lg where the header CTA takes over. `body` carries matching
  padding-bottom (global.css) so this never covers content.
*/}
<div
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-3 border-t border-ink-200 bg-white/95 backdrop-blur-sm lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <a
    href={waLink(waMessage)}
    target="_blank"
    rel="noopener"
    class="plausible-event-name=WhatsApp+Click flex flex-col items-center justify-center gap-0.5 bg-whatsapp py-3 text-ink-950"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"
      ></path>
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z"
      ></path>
    </svg>
    <span class="text-xs font-semibold">WhatsApp</span>
  </a>

  <a
    href={`tel:${CONTACT.phoneE164}`}
    class="plausible-event-name=Call+Click flex flex-col items-center justify-center gap-0.5 border-x border-ink-200 py-3 text-ink-950"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.03-.24c1.12.37 2.33.57 3.56.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.23.2 2.44.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"
      ></path>
    </svg>
    <span class="text-xs font-semibold">Call</span>
  </a>

  <a
    href="/contact/"
    class="plausible-event-name=Quote+Click flex flex-col items-center justify-center gap-0.5 bg-accent-600 py-3 text-white"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM7 9h10v2H7V9zm6 5H7v-2h6v2zm4-6H7V6h10v2z"
      ></path>
    </svg>
    <span class="text-xs font-semibold">Get a quote</span>
  </a>
</div>
