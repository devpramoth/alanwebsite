---
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  /** Set false where the page already renders its own <h2>. */
  showHeading?: boolean;
}

const { faqs, heading = 'Common questions', showHeading = true } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="mt-16">
      {showHeading && (
        <h2 class="font-display text-2xl font-extrabold text-ink-950 lg:text-3xl">{heading}</h2>
      )}
      <dl class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
        {faqs.map((f) => (
          <div class="py-6">
            <dt class="font-display text-lg font-bold text-ink-950">{f.q}</dt>
            <dd class="mt-2 leading-relaxed text-ink-600">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
