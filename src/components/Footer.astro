---
import { getCollection } from 'astro:content';
import { SITE, CONTACT, DISTRICTS } from '../config';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800 bg-ink-950 text-ink-300">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-extrabold text-white">English Handyman Berlin</p>
      <p class="mt-3 text-sm leading-relaxed text-ink-400">{SITE.tagline}</p>
      <p class="mt-5 text-sm leading-relaxed">
        <a
          href={`tel:${CONTACT.phoneE164}`}
          class="plausible-event-name=Call+Click font-semibold text-white hover:text-accent-500"
        >
          {CONTACT.phoneDisplay}
        </a>
        {
          CONTACT.email && (
            <>
              <br />
              <a href={`mailto:${CONTACT.email}`} class="hover:text-accent-500">
                {CONTACT.email}
              </a>
            </>
          )
        }
        {/* TODO: no mailbox on this domain yet — see CONTACT.email in src/config.ts */}
      </p>
    </div>

    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-widest text-white">Services</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.id}/`} class="hover:text-accent-500">
                {s.data.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-widest text-white">Areas</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          DISTRICTS.map((d) => (
            <li>
              <a href={`/areas/${d.slug}/`} class="hover:text-accent-500">
                {d.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-widest text-white">More</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/gallery/" class="hover:text-accent-500">Gallery</a></li>
        <li><a href="/about/" class="hover:text-accent-500">About</a></li>
        <li><a href="/faq/" class="hover:text-accent-500">FAQ</a></li>
        <li><a href="/contact/" class="hover:text-accent-500">Get a quote</a></li>
      </ul>
      {/*
        TODO: Impressum and Datenschutzerklärung are legally required in Germany
        and are being handled separately. Add the links here once the pages exist.
      */}
    </div>
  </div>

  <div class="border-t border-ink-800">
    <p class="container-page py-6 text-xs text-ink-500">
      &copy; {year} English Handyman Berlin. Berlin and surrounding areas.
    </p>
  </div>
</footer>
