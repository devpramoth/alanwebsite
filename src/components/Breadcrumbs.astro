---
interface Props {
  /** Trail excluding Home, which is prepended here. Last item is the current page. */
  trail: { name: string; path: string }[];
}

const { trail } = Astro.props;
const items = [{ name: 'Home', path: '/' }, ...trail];
---

<nav aria-label="Breadcrumb" class="container-page pt-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-500">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-ink-700">
              {item.name}
            </span>
          ) : (
            <a href={item.path} class="hover:text-accent-700 hover:underline">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
